      name: vdb-redis-cluster
      namespace: vdb
      resourceVersion: '280032'
      uid: 334d502c-7c57-469e-b028-a6a11b242616
    spec:
      persistentVolumeClaimRetentionPolicy:
        whenDeleted: Retain
        whenScaled: Retain
      podManagementPolicy: OrderedReady
      replicas: 3
      revisionHistoryLimit: 10
      selector:
        matchLabels:
          app.kubernetes.io/instance: vdb
          app.kubernetes.io/name: redis-cluster
      serviceName: vdb-redis-cluster-headless
      template:
        metadata:
          annotations:
            prometheus.io/path: /metrics
            prometheus.io/port: '9121'
            prometheus.io/scrape: 'true'
          labels:
            app.kubernetes.io/instance: vdb
            app.kubernetes.io/name: redis-cluster
        spec:
          containers:
          - command:
            - sh
            - -c
            - |-
              set -e
              REDIS_PASSWORD=$(cat /secrets/password)
              POD_HOSTNAME="${HOSTNAME}.vdb-redis-cluster-headless.vdb.svc.cluster.local"
              POD_IP=$(hostname -i)
  
              echo "Pod hostname: ${POD_HOSTNAME}"
              echo "Pod IP: ${POD_IP}"
  
              # Fix nodes.conf to update IPs while keeping hostnames
              # Only do this if nodes.conf exists AND contains cluster node information WITH slot assignments
              if [ -f /data/nodes.conf ] && grep -q "^[a-f0-9]\{40\}" /data/nodes.conf && grep -q "connected" /data/nodes.conf; then
                echo "Found existing cluster configuration with slot assignments in nodes.conf"
                echo "Fixing nodes.conf - updating stale IPs..."
                echo "Original nodes.conf:"
                cat /data/nodes.conf
  
                # For each hostname, resolve current IP and update in nodes.conf
                for i in 0 1 2; do
                  NODE_HOSTNAME="vdb-redis-cluster-${i}.vdb-redis-cluster-headless.vdb.svc.cluster.local"
  
                  # Resolve the current IP for this hostname (with timeout)
                  CURRENT_IP=$(timeout 5 getent hosts ${NODE_HOSTNAME} | awk '{print $1}' | head -1 || echo "")
  
                  if [ -n "$CURRENT_IP" ]; then
                    echo "Updating ${NODE_HOSTNAME} to use IP ${CURRENT_IP}"
  
                    # Escape dots in hostname for sed pattern matching
                    ESCAPED_HOSTNAME=$(echo "${NODE_HOSTNAME}" | sed 's/\./\\./g')
  
                    # Pattern 1: Handle normal IPs - <node-id> <old-ip>:6379@16379,<hostname>
                    # Replace old IP with current IP
                    sed -i "s/\([a-f0-9]\{40\} \)[0-9.]\{7,15\}\(:6379@16379,${ESCAPED_HOSTNAME}\)/\1${CURRENT_IP}\2/g" /data/nodes.conf
  
                    # Pattern 2: Handle disconnected nodes with :0@0 - <node-id> :0@0,<hostname>
                    # Replace :0@0 with current IP and port
                    sed -i "s/\([a-f0-9]\{40\} \):0@0\(,${ESCAPED_HOSTNAME}\)/\1${CURRENT_IP}:6379@16379\2/g" /data/nodes.conf
  
                    # Pattern 3: Remove noaddr flag if present
                    sed -i "s/\(${ESCAPED_HOSTNAME}[^ ]* [^ ]*\),noaddr /\1 /g" /data/nodes.conf
                    sed -i "s/ master,noaddr / master /g" /data/nodes.conf
                    sed -i "s/ slave,noaddr / slave /g" /data/nodes.conf
  
                    echo "✅ Updated IP for ${NODE_HOSTNAME} to ${CURRENT_IP}"
                  else
                    echo "Could not resolve IP for ${NODE_HOSTNAME}, skipping"
                  fi
                done
  
                echo "Updated nodes.conf:"
                cat /data/nodes.conf
              else
                echo "No existing cluster configuration with slots found - fresh start or awaiting cluster initialization"
              fi
  
              cat > /tmp/redis.conf <<REDISCONF
              port 6379
              cluster-enabled yes
              cluster-config-file /data/nodes.conf
              cluster-node-timeout 15000
              cluster-require-full-coverage no
              cluster-allow-reads-when-down yes
  
              cluster-announce-hostname ${POD_HOSTNAME}
              cluster-announce-ip ${POD_IP}
              cluster-preferred-endpoint-type hostname
  
              protected-mode no
              requirepass ${REDIS_PASSWORD}
              masterauth ${REDIS_PASSWORD}
  
              maxmemory-policy allkeys-lru
  
  
              # Cluster timeout
              cluster-node-timeout 15000
  
              # Load Redis modules with their configuration
              loadmodule /usr/local/lib/redis/modules/redisearch.so MAXSEARCHRESULTS 10000 MAXAGGREGATERESULTS 10000 TIMEOUT 5000
              loadmodule /usr/local/lib/redis/modules/rejson.so MAXDEPTH 1000
  
              save ""
              appendonly yes
              appendfilename "appendonly.aof"
              appendfsync everysec
              auto-aof-rewrite-percentage 100
              auto-aof-rewrite-min-size 64mb
              REDISCONF
  
              echo "Starting Redis with hostname: ${POD_HOSTNAME} and IP: ${POD_IP}"
              exec redis-server /tmp/redis.conf
            env:
            - name: HOSTNAME
              valueFrom:
                fieldRef:
                  apiVersion: v1
                  fieldPath: metadata.name
            - name: REDIS_PASSWORD
              valueFrom:
                secretKeyRef:
                  key: REDIS_PASSWORD
                  name: redis-cluster-secret
            image: redis:8.2.2
            imagePullPolicy: IfNotPresent
            livenessProbe:
              exec:
                command:
                - sh
                - -c
                - redis-cli -a $(cat /secrets/password) ping
              failureThreshold: 3
              initialDelaySeconds: 30
              periodSeconds: 10
              successThreshold: 1
              timeoutSeconds: 5
            name: redis
            ports:
            - containerPort: 6379
              name: redis
              protocol: TCP
            - containerPort: 16379
              name: cluster-bus
              protocol: TCP
            readinessProbe:
              exec:
                command:
                - sh
                - -c
                - redis-cli -a $(cat /secrets/password) ping
              failureThreshold: 3
              initialDelaySeconds: 5
              periodSeconds: 5
              successThreshold: 1
              timeoutSeconds: 3
            resources:
              limits:
                cpu: '16'
                memory: 16Gi
              requests:
                cpu: '2'
                memory: 4Gi
            securityContext:
              allowPrivilegeEscalation: false
              capabilities:
                drop:
                - ALL
              readOnlyRootFilesystem: true
              runAsNonRoot: true
              runAsUser: 1000
            terminationMessagePath: /dev/termination-log
            terminationMessagePolicy: File
            volumeMounts:
            - mountPath: /data
              name: data
            - mountPath: /secrets
              name: secrets
              readOnly: true
            - mountPath: /tmp
